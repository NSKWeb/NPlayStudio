# NPlayStudio backend configuration
NPLAY_ENV=development
NPLAY_HOST=0.0.0.0
NPLAY_PORT=8000

# SQLite database file
NPLAY_DB_PATH=backend/data/nplaystudio.db

# Working directories (must be writable)
NPLAY_UPLOAD_DIR=uploads
NPLAY_OUTPUT_DIR=outputs

# Redis / ARQ
NPLAY_REDIS_URL=redis://localhost:6379/0
NPLAY_QUEUE_NAME=nplaystudio

# Limits
NPLAY_MAX_UPLOAD_MB=512
NPLAY_MAX_MERGE_FILES=10
NPLAY_FILE_TTL_SECONDS=3600
NPLAY_CLEANUP_INTERVAL_SECONDS=300

# CORS: comma separated origins, or * for all
NPLAY_CORS_ORIGINS=*
